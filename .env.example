# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Required: Google AI Studio API key (free tier)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Required: Discord webhook URL for job delivery
# Create one at: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: Local directory to copy rendered PDFs into (e.g., a cloud sync folder)
# Leave blank to skip. Subdirectories ai_engineering/ and data_science/ are created automatically.
RESUME_EXPORT_DIR=

# Optional: Minimum Gemini fit score (0-100) to trigger PDF rendering + delivery.
# Listings below this threshold are logged and skipped. Default: 55
MIN_FIT_SCORE=55

